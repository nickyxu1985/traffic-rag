  "result_record_template": {
    "actual_package": "NOT RUN",
    "actual_chunk_ids": [],
    "actual_article_items_status": [],
    "context_refs_expansion": "NOT RUN",
    "retrieval_result": "NOT RUN",
    "generation_result": "NOT RUN",
    "citation_result": "NOT RUN",
    "manual_claim_review": "PENDING",
    "overall": "NOT RUN"
  },
  "cases": [
    {
      "case_id": "T1",
      "mode": "B",
      "question": "機車與汽車駕駛經測試檢定符合第35條第1項第1款或第2款時，罰鍰範圍和吊扣期限各是多少？附載未滿12歲兒童、肇事致人受傷，或致人重傷／死亡時如何變化？一般違規點數何時記1至3點，而第35條這些情形如何判斷？",
      "expected_gate": "core_only",
      "expected_hits": [
        {"package": "core", "article": "35", "item": "1", "status": "current", "required_source_quote": "機車駕駛人處新臺幣一萬五千元以上九萬元以下罰鍰，汽車駕駛人處新臺幣三萬元以上十二萬元以下罰鍰"},
        {"package": "core", "article": "63", "item": "1", "status": "current", "required_source_quote": "經當場舉發者，並得依對行車秩序及交通安全危害程度記違規點數一點至三點"},
        {"package": "core", "article": "63", "item": "2", "status": "current", "required_source_quote": "已受吊扣或吊銷駕駛執照處分者，不予記違規點數"}
      ],
      "expected_claims": ["機車15,000–90,000元、汽車30,000–120,000元", "一般吊扣1–2年", "附載未滿12歲兒童或肇事致人受傷為吊扣2–4年", "致人重傷或死亡為吊銷且不得再考領", "一般汽車駕駛人經當場舉發可依危害程度記1–3點", "§35第1項已受吊扣／吊銷者依§63第2項不予記點"],
      "forbidden_claims": ["引用§35新版pending數字作為現行罰鍰", "未命中chunk的點數或處分"],
      "manual_review_required": true
    },
    {
      "case_id": "T2",
      "mode": "B",
      "question": "請依本資料庫告訴我第92-2條修正後，哪些失智症或體格變化情形會影響駕駛資格、會如何註銷駕照？",
      "expected_gate": "core_only",
      "expected_hits": [],
      "forbidden_hit_articles": ["92-2"],
      "forbidden_namespaces": ["pending:"],
      "expected_refusal_text": "本資料庫查不到",
      "forbidden_claims": ["法律沒有規定", "第92-2條的法律效果", "施行日期或適用條件"],
      "manual_review_required": true
    },
    {
      "case_id": "T3-B",
      "mode": "B",
      "question": "第92-2條目前生效了嗎？",
      "expected_gate": "core_only",
      "expected_hits": [],
      "forbidden_hit_articles": ["92-2"],
      "forbidden_namespaces": ["pending:"],
      "expected_refusal_text": "本資料庫查不到",
      "forbidden_claims": ["宣稱已生效或尚未生效", "推測施行日期"],
      "manual_review_required": true
    },
    {
      "case_id": "T3-A",
      "mode": "A",
      "question": "請問2025-11-19增訂的《道路交通管理處罰條例》第92-2條何時施行？請依資料庫中的對應條文與 metadata 回答。",
      "expected_gate": "explicit_pending_intent_then_matching_hit_then_status_proof",
      "expected_hits": [
        {"package": "pending", "article": "92-2", "item": "any", "status": "not_yet_effective"}
      ],
      "effective_date_rule": "Show metadata effective_date/預定施行日期 only when non-empty and known; say undetermined only when absent/null/unknown.",
      "expected_answer_prefix": "注意：以下僅依本資料庫標示為尚未生效的條文整理，不代表現行有效規定。",
      "forbidden_claims": ["僅因 core miss 就開啟 pending", "用外部資料覆蓋 metadata 日期"],
      "manual_review_required": true
    },
    {
      "case_id": "T4-core",
      "mode": "B",
      "question": "第35條第4項說的「拒絕接受第一項測試檢定」是指哪些測試情形？拒測罰鍰及駕照處分為何？",
      "expected_gate": "core_only_same_version_context_refs",
      "expected_hits": [
        {"package": "core", "article": "35", "item": "4", "status": "current"},
        {"package": "core", "article": "35", "item": "1", "status": "current", "required_by_context_ref_from_item": "4"}
      ],
      "context_refs_edge": {"package": "core", "from": {"article": "35", "item": "4"}, "to": {"article": "35", "item": "1"}},
      "forbidden_claims": ["跨 package 連動", "混合不同修正版本", "未命中chunk之罰鍰或處分"],
      "manual_review_required": true
    },
    {
      "case_id": "T4-pending",
      "mode": "A",
      "question": "請問2026-08-17修正公布的第35條第1項，汽車與機車的新罰鍰範圍及施行日期是什麼？",
      "expected_gate": "explicit_pending_intent_then_matching_hit_then_status_proof",
      "expected_hits": [
        {"package": "pending", "article": "35", "item": "1", "status": "not_yet_effective", "expected_source_amounts": ["機車新臺幣一萬八千元以上十二萬元以下", "汽車新臺幣三萬六千元以上十五萬元以下"]}
      ],
      "effective_date_rule": "Show pending chunk metadata date when present; otherwise state metadata date is absent/unknown and do not infer one.",
      "expected_answer_prefix": "注意：以下僅依本資料庫標示為尚未生效的條文整理，不代表現行有效規定。",
      "forbidden_claims": ["把core舊版和pending新版金額拼成單一現行答案", "無對應pending hit時退回core代答"],
      "manual_review_required": true
    },
    {
      "case_id": "T5-A",
      "mode": "A",
      "question": "新法會怎麼影響交通罰則？",
      "expected_gate": "ambiguous_ask_clarification_before_pending_search",
      "expected_hits": [],
      "expected_pending_search": false,
      "expected_clarification": "請確認你要查資料庫的現行 core 規定，還是某一修正案／施行狀態；若是修正案請提供條號或修正日期。",
      "forbidden_claims": ["先行搜尋或引用pending", "只因core miss就轉pending", "未檢索的修正內容"],
      "manual_review_required": true
    },
    {
      "case_id": "T5-B",
      "mode": "B",
      "question": "我是汽車駕駛，酒測超過標準；想知道第35條的罰鍰，近十年是否有相同違規我不確定。需要補充什麼？",
      "expected_gate": "core_only_ask_only_materially_missing_fact",
      "expected_hits": [
        {"package": "core", "article": "35", "item": "1", "status": "current"}
      ],
      "expected_missing_fact": "近十年內第35條相關違規次數／是否再犯（僅當要判斷精確金額時）",
      "already_provided_do_not_ask": ["車種", "酒測是否超過標準"],
      "irrelevant_do_not_ask": ["身份資料", "乘客年齡", "事故細節"],
      "forbidden_namespaces": ["pending:"],
      "manual_review_required": true
    }
  ]
